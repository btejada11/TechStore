@model TechStore.Models.RegisterViewModel
@{
    ViewData["Title"] = "Registro de Usuario";
}

<div class="container py-5">
    <div class="row justify-content-center align-items-center min-vh-75">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white">
                
                <!-- Encabezado -->
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-dark" style="font-family: 'Orbitron', sans-serif;">
                        TECH<span style="color: #00d2ff;">STORE</span>
                    </h2>
                    <p class="text-muted small">Crea tu cuenta como cliente para empezar a comprar</p>
                </div>

                <!-- Formulario de Registro -->
                <form asp-controller="Account" asp-action="Register" method="post">
                    
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small py-2" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control rounded-3" autocomplete="username" aria-required="true" placeholder="nombre@ejemplo.com" />
                        <label asp-for="Email" class="text-muted"><i class="bi bi-envelope me-1"></i> Correo Electrónico</label>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Password" type="password" class="form-control rounded-3" autocomplete="new-password" aria-required="true" placeholder="Contraseña" />
                        <label asp-for="Password" class="text-muted"><i class="bi bi-lock me-1"></i> Contraseña</label>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="ConfirmPassword" type="password" class="form-control rounded-3" autocomplete="new-password" aria-required="true" placeholder="Confirmar Contraseña" />
                        <label asp-for="ConfirmPassword" class="text-muted"><i class="bi bi-lock-fill me-1"></i> Confirmar Contraseña</label>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="w-100 btn btn-lg text-white fw-bold rounded-pill py-2 shadow-sm" style="background: linear-gradient(135deg, #1B4079 0%, #122d56 100%);">
                        <i class="bi bi-person-plus-fill me-2"></i> Registrarse
                    </button>
                </form>

                <!-- Pie de tarjeta: Enlace a Login -->
                <div class="text-center mt-4 pt-3 border-top">
                    <p class="text-muted small mb-0">
                        ¿Ya tienes una cuenta?
                        <a asp-action="Login" class="fw-semibold text-decoration-none" style="color: #1B4079;">Inicia sesión</a>
                    </p>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
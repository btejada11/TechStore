@model IEnumerable<TechStore.Models.Categoria>

@{
    ViewData["Title"] = "Categorías";
}

<div class="container-fluid px-0 mb-5">

    <!-- 1. BANNER HERO PRINCIPAL -->
    <header class="p-4 p-md-5 rounded-4 text-white shadow-sm mb-4" style="background: linear-gradient(135deg, #1B4079 0%, #122d56 100%);">
        <h1 class="display-5 fw-bold mb-2" style="font-family: 'Orbitron', sans-serif;">
            Gestión de <span style="color: #00d2ff;">Categorías</span>
        </h1>
        <p class="lead text-white-50 mb-0" style="max-width: 700px;">
            Sistema web para administración y consulta de información de TechStore.
        </p>
    </header>

    <!-- 2. SECCIÓN DESTACADA: ¿En qué categorías nos enfocamos? -->
    <section class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
        <div class="row g-0 align-items-center">
            <div class="col-md-8 p-4 p-md-5">
                <span class="text-uppercase fw-bold small d-block mb-1" style="color: #1B4079;">
                    Catálogo TechStore
                </span>
                <h3 class="fw-bold text-dark mb-3">¿En qué categorías nos enfocamos?</h3>
                <p class="text-muted leading-relaxed mb-0 fs-6">
                    TechStore se enfoca en ofrecer una amplia variedad de categorías de productos tecnológicos, incluyendo computadoras, teléfonos inteligentes, accesorios y más. Nuestro objetivo es proporcionar a nuestros clientes la mejor experiencia de compra en línea, con productos de alta calidad y un servicio al cliente excepcional.
                </p>
            </div>
            <div class="col-md-4 bg-light text-center p-3 d-none d-md-block border-start">
                <img src="~/Images/Compu.jpg"
                     class="img-fluid rounded-3 shadow-sm"
                     alt="Categorías"
                     style="max-height: 200px; width: 100%; object-fit: cover;"
                     onerror="this.onerror=null; this.src='https://via.placeholder.com/600x350?text=TechStore';" />
            </div>
        </div>
    </section>

    <!-- Bloque de Alertas (TempData) -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm rounded-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm rounded-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- 3. ACCIONES PRINCIPALES: Contador y Botón Crear -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <span class="badge text-white px-3 py-2 rounded-pill fs-6 shadow-sm d-inline-flex align-items-center gap-2" style="background-color: #1B4079;">
            <i class="bi bi-tags-fill"></i> @Model.Count() Categorías registradas
        </span>

        <a asp-action="Create" class="btn btn-success fw-bold px-4 py-2 shadow-sm rounded-pill d-inline-flex align-items-center gap-2">
            <i class="bi bi-plus-circle-fill"></i> Nueva Categoría
        </a>
    </div>

    <!-- 4. GRILLA DE CATEGORÍAS -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted fs-5">No hay categorías registradas en la base de datos.</p>
            </div>
        }
        else
        {
            @foreach (var categoria in Model)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden d-flex flex-column">

                        <!-- Imagen con respaldo si falla el origen -->
                        <div class="bg-white d-flex align-items-center justify-content-center p-3 border-bottom" style="height: 180px;">
                            <img src="@categoria.Imagen"
                                 class="img-fluid"
                                 alt="@categoria.Nombre"
                                 style="max-height: 100%; object-fit: contain;"
                                 onerror="this.onerror=null; this.src='https://via.placeholder.com/300x180?text=Categor%C3%ADa';" />
                        </div>

                        <!-- Cuerpo de la tarjeta -->
                        <div class="card-body d-flex flex-column p-3">
                            <h5 class="card-title fw-bold text-dark mb-2 text-truncate" title="@categoria.Nombre">
                                @categoria.Nombre
                            </h5>

                            <p class="card-text text-muted small flex-grow-1 mb-3" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                @categoria.Descripcion
                            </p>

                            <!-- Acciones del CRUD (Editar / Eliminar) -->
                            <div class="d-flex gap-2 pt-2 border-top mt-auto">
                                <a asp-action="Edit" asp-route-id="@categoria.Id" class="btn btn-outline-warning btn-sm w-50 rounded-pill fw-semibold d-inline-flex align-items-center justify-content-center gap-1">
                                    <i class="bi bi-pencil-square"></i> Editar
                                </a>
                                <a asp-action="Delete" asp-route-id="@categoria.Id" class="btn btn-outline-danger btn-sm w-50 rounded-pill fw-semibold d-inline-flex align-items-center justify-content-center gap-1">
                                    <i class="bi bi-trash"></i> Eliminar
                                </a>
                            </div>
                        </div>

                    </div>
                </div>
            }
        }
    </div>

</div>
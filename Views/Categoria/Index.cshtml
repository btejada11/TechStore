@model IEnumerable<TechStore.Models.Categoria>

@{
    ViewData["Title"] = "Categorías";
}

<header class="Contact-header mt-4">
    <h1>TechStore</h1>
    <p>Sistema web para administración y consulta de información de TechStore</p>
    <p class="fw-bold">@Model.Count() Categorías registradas</p>
</header>

<section class="about-container">
    <article class="about-content">
        <h2>¿En qué categorías nos enfocamos?</h2>
        <p>
            TechStore se enfoca en ofrecer una amplia variedad de categorías de productos tecnológicos, incluyendo computadoras, teléfonos inteligentes, accesorios y más. Nuestro objetivo es proporcionar a nuestros clientes la mejor experiencia de compra en línea, con productos de alta calidad y un servicio al cliente excepcional.
        </p>
    </article>
    <aside>
        <img src="~/Images/Compu.jpg" class="about-image" alt="Categorías" />
    </aside>
</section>

<section class="container py-5">
    <div class="text-center mb-5">
        <span class="badge rounded-pill px-3 py-2 mb-2" style="background-color: #4D7C84;">EXPLORA</span>
        <h2 class="d-block border-bottom border-3 pb-2" style="border-color: #4D7C84 !important; width: fit-content; margin: 0 auto;">
            Nuestras Categorías
        </h2>
    </div>

    <div class="categoria-grid">
        @if (!Model.Any())
        {
            <div class="text-center py-4 text-muted w-100">
                No hay categorías registradas en la base de datos.
            </div>
        }
        else
        {
            @foreach (var categoria in Model)
            {
                <div class="card h-100 shadow-sm categoria-card">
                    <img src="@categoria.Imagen" class="card-img-top categoria-img" alt="@categoria.Nombre" />
                    <div class="card-body">
                        <h5 class="card-title fw-bold">@categoria.Nombre</h5>
                        <p class="card-text text-muted">@categoria.Descripcion</p>
                        <div class="mt-2">
                            <span class="badge bg-light text-dark border">ID: #@categoria.Id</span>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</section>

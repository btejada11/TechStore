@model IEnumerable<TechStore.Models.Producto>

@{
    ViewData["Title"] = "Catálogo de Productos";
}

<!-- ENCABEZADO DE LA SECCIÓN DE PRODUCTOS -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom">
    <div>
        <h2 class="fw-bold text-dark mb-1">Catálogo de Productos</h2>
        <p class="text-muted small mb-0">Explora nuestra colección de tecnología, dispositivos y accesorios.</p>
    </div>
    
    <!-- Contador dinámico de productos recibidos desde el modelo -->
    <div class="mt-2 mt-md-0">
        <span class="badge text-white px-3 py-2 rounded-pill fs-6" style="background-color: #1B4079;">
            <i class="bi bi-box-seam me-1"></i> @Model.Count() Productos disponibles
        </span>
    </div>
</div>

<!-- GRILLA RESPONSIVA DE PRODUCTOS -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4">
    @foreach (var item in Model)
    {
        <div class="col">
            <!-- Tarjeta individual de producto con animación suave -->
            <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden position-relative">
                
                <!-- Etiqueta superior del estado del producto (Nuevo u Open Box) -->
                <div class="position-absolute top-0 end-0 m-2 z-1">
                    @if (item.Estado == TechStore.Models.Estado.Nuevo)
                    {
                        <span class="badge bg-success shadow-sm">Nuevo</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark shadow-sm">Open Box</span>
                    }
                </div>

                <!-- Imagen del producto ajustada dinámicamente -->
                <div class="bg-white d-flex align-items-center justify-content-center p-3" style="height: 200px;">
                    <img src="@item.Imagen" class="img-fluid" alt="@item.Nombre" style="max-height: 100%; object-fit: contain;">
                </div>

                <!-- Detalles y cuerpo de la tarjeta -->
                <div class="card-body d-flex flex-column pt-2">
                    <!-- Categoría del producto -->
                    <span class="text-uppercase text-muted fw-bold small mb-1" style="font-size: 0.75rem;">
                        @item.Categoria
                    </span>

                    <!-- Título y descripción -->
                    <h6 class="card-title fw-bold text-dark mb-1 text-truncate" title="@item.Nombre">@item.Nombre</h6>
                    <p class="card-text text-muted small flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                        @item.Descripcion
                    </p>

                    <!-- Pie de la tarjeta: Precio y botón de acción -->
                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                        <div>
                            <small class="text-muted d-block" style="font-size: 0.7rem;">Precio</small>
                            <span class="fs-5 fw-bold text-dark">$@item.Precio.ToString("F2")</span>
                        </div>
                        <button class="btn text-white btn-sm rounded-pill px-3 fw-semibold" style="background-color: #1B4079;">
                            <i class="bi bi-cart-plus me-1"></i> Comprar
                        </button>
                    </div>
                </div>

            </div>
        </div>
    }
</div>
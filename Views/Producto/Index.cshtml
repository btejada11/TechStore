@model IEnumerable<TechStore.Models.Producto>

@{
    ViewData["Title"] = "Catalogo de Productos";
}

<section class="container-fluid px-0 mb-4">
    <!-- Banner estilo Hero sin la insignia superior -->
    <div class="p-4 p-md-5 rounded-4 text-white shadow-sm" style="background: linear-gradient(135deg, #1B4079 0%, #122d56 100%);">
        <h1 class="display-5 fw-bold mb-2" style="font-family: 'Orbitron', sans-serif;">
            Catálogo de <span style="color: #00d2ff;">Productos</span>
        </h1>
        <p class="lead text-white-50 mb-0" style="max-width: 700px;">
            Explora nuestra colección de tecnología, dispositivos y accesorios de última generación con la mejor calidad.
        </p>
    </div>
</section>

<section class="container-fluid px-2">
    <!-- Acciones principales: Contador de productos disponibles y Boton Agregar Producto -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <span class="badge text-white px-3 py-2 rounded-pill fs-6 shadow-sm d-inline-flex align-items-center gap-2" style="background-color: #1B4079;">
            <i class="bi bi-box-seam-fill"></i> @Model.Count() Productos disponibles
        </span>

        <a asp-action="Create" class="btn btn-success fw-bold px-4 py-2 shadow-sm rounded-pill d-inline-flex align-items-center gap-2">
            <i class="bi bi-plus-circle-fill"></i> Agregar Producto
        </a>
    </div>

    <!-- Avisos ocultos para alertas de SweetAlert -->
    @if (TempData["Eliminado"] != null)
    {
        <div id="mensaje-eliminado" data-mensaje="@TempData["Eliminado"]" hidden></div>
    }

    @if (TempData["Exito"] != null)
    {
        <div id="mensaje-compra" data-tipo="success" data-mensaje="@TempData["Exito"]" hidden></div>
    }

    @if (TempData["Error"] != null)
    {
        <div id="mensaje-compra" data-tipo="error" data-mensaje="@TempData["Error"]" hidden></div>
    }

    <!-- Grilla de productos -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted fs-5">No hay productos registrados en la base de datos.</p>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card producto-card h-100 border-0 shadow-sm rounded-3 overflow-hidden position-relative">

                        <!-- Etiqueta del estado del producto -->
                        <div class="position-absolute top-0 end-0 m-2 z-1">
                            @if (item.Estado == TechStore.Models.Estado.Nuevo)
                            {
                                <span class="badge bg-success shadow-sm">Nuevo</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark shadow-sm">Open Box</span>
                            }
                        </div>

                        <!-- Imagen del producto -->
                        <div class="bg-white d-flex align-items-center justify-content-center p-3" style="height: 200px;">
                            <img src="@item.Imagen" class="img-fluid" alt="@item.Nombre" style="max-height: 100%; object-fit: contain;">
                        </div>

                        <!-- Cuerpo de la tarjeta -->
                        <div class="card-body d-flex flex-column pt-2">
                            <span class="text-uppercase text-muted fw-bold small mb-1" style="font-size: 0.75rem;">
                                @(item.Categoria?.Nombre ?? "Sin Categoria")
                            </span>

                            <h6 class="card-title fw-bold text-dark mb-1 text-truncate" title="@item.Nombre">@item.Nombre</h6>
                            <p class="card-text text-muted small flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @item.Descripcion
                            </p>

                            <!-- Indicador de stock -->
                            <div class="mb-1">
                                @if (item.Stock == 0)
                                {
                                    <span class="badge bg-danger">Agotado</span>
                                }
                                else if (item.Stock <= 5)
                                {
                                    <span class="badge bg-warning text-dark">Stock bajo: @item.Stock</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border">Stock: @item.Stock</span>
                                }
                            </div>

                            <!-- Botones de Editar y Eliminar -->
                            <div class="d-flex gap-2 mb-2 mt-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm w-50 rounded-pill fw-semibold d-inline-flex align-items-center justify-content-center gap-1">
                                    <i class="bi bi-pencil-square"></i> Editar
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm w-50 rounded-pill fw-semibold d-inline-flex align-items-center justify-content-center gap-1">
                                    <i class="bi bi-trash"></i> Eliminar
                                </a>
                            </div>

                            <!-- Pie de tarjeta con precio y boton comprar -->
                            <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                                <div>
                                    <small class="text-muted d-block" style="font-size: 0.7rem;">Precio</small>
                                    <span class="fs-5 fw-bold text-dark">$@item.Precio.ToString("F2")</span>
                                </div>
                                <form asp-action="Comprar" asp-route-id="@item.Id" method="post">
                                    <button type="submit" class="btn text-white btn-sm rounded-pill px-3 fw-semibold" style="background-color: #1B4079;" disabled="@(item.Stock == 0)">
                                        <i class="bi bi-cart-plus me-1"></i> Comprar
                                    </button>
                                </form>
                            </div>
                        </div>

                    </div>
                </div>
            }
        }
    </div>
</section>
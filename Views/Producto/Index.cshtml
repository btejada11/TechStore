@model IEnumerable<TechStore.Models.Producto>

@{
    ViewData["Title"] = "Catálogo de Productos";
}

<!-- ENCABEZADO DE LA SECCIÓN DE PRODUCTOS -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom mt-3">
    <div>
        <h2 class="fw-bold text-dark mb-1">Catálogo de Productos</h2>
        <p class="text-muted small mb-0">Explora nuestra colección de tecnología, dispositivos y accesorios.</p>
    </div>

    <!-- Botón de Agregar y Contador dinámico -->
    <div class="mt-2 mt-md-0 d-flex align-items-center gap-2">
        <a asp-action="Create" class="btn btn-success rounded-pill px-3 fw-semibold btn-sm">
            <i class="bi bi-plus-circle me-1"></i> Agregar Producto
        </a>
        <span class="badge text-white px-3 py-2 rounded-pill fs-6" style="background-color: #1B4079;">
            <i class="bi bi-box-seam me-1"></i> @Model.Count() Productos disponibles
        </span>
    </div>
</div>

<!-- Aviso oculto que lee el script para mostrar el mensaje tras eliminar -->
@if (TempData["Eliminado"] != null)
{
    <div id="mensaje-eliminado" data-mensaje="@TempData["Eliminado"]" hidden></div>
}

<!-- Aviso oculto que lee el script para mostrar el resultado de la compra (éxito o error) -->
@if (TempData["Exito"] != null)
{
    <div id="mensaje-compra" data-tipo="success" data-mensaje="@TempData["Exito"]" hidden></div>
}
@if (TempData["Error"] != null)
{
    <div id="mensaje-compra" data-tipo="error" data-mensaje="@TempData["Error"]" hidden></div>
}

<!-- GRILLA RESPONSIVA DE PRODUCTOS -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4">
    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5">
            <p class="text-muted">No hay productos registrados en la base de datos.</p>
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            <div class="col">
                <!-- Tarjeta individual de producto con animación suave -->
                <div class="card producto-card h-100 border-0 shadow-sm rounded-3 overflow-hidden position-relative">

                    <!-- Etiqueta superior del estado del producto (Nuevo u Open Box) -->
                    <div class="position-absolute top-0 end-0 m-2 z-1">
                        @if (item.Estado == TechStore.Models.Estado.Nuevo)
                        {
                            <span class="badge bg-success shadow-sm">Nuevo</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark shadow-sm">Open Box</span>
                        }
                    </div>

                    <!-- Imagen del producto ajustada dinámicamente -->
                    <div class="bg-white d-flex align-items-center justify-content-center p-3" style="height: 200px;">
                        <img src="@item.Imagen" class="img-fluid" alt="@item.Nombre" style="max-height: 100%; object-fit: contain;">
                    </div>

                    <!-- Detalles y cuerpo de la tarjeta -->
                    <div class="card-body d-flex flex-column pt-2">
                        <!-- Categoría del producto obtenida desde la relación de EF Core -->
                        <span class="text-uppercase text-muted fw-bold small mb-1" style="font-size: 0.75rem;">
                            @(item.Categoria?.Nombre ?? "Sin Categoría")
                        </span>

                        <!-- Título y descripción -->
                        <h6 class="card-title fw-bold text-dark mb-1 text-truncate" title="@item.Nombre">@item.Nombre</h6>
                        <p class="card-text text-muted small flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            @item.Descripcion
                        </p>

                        <!-- Indicador de stock del producto (Agotado, Stock bajo o Stock disponible) -->
                        <div class="mb-1">
                            @if (item.Stock == 0)
                            {
                                <span class="badge bg-danger">Agotado</span>
                            }
                            else if (item.Stock <= 5)
                            {
                                <span class="badge bg-warning text-dark">Stock bajo: @item.Stock</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-dark border">Stock: @item.Stock</span>
                            }
                        </div>

                        <!-- Panel de Acciones de Administración (Editar y Eliminar) -->
                        <div class="d-flex gap-2 mb-2 mt-2">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm w-50 rounded-pill fw-semibold">
                                <i class="bi bi-pencil-square"></i> Editar
                            </a>
                            <!-- Eliminar con confirmación de SweetAlert (se activa desde site.js con la clase swal-delete-form) -->
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="swal-delete-form w-50" data-nombre="@item.Nombre">
                                <button type="submit" class="btn btn-outline-danger btn-sm w-100 rounded-pill fw-semibold">
                                    <i class="bi bi-trash"></i> Eliminar
                                </button>
                            </form>
                        </div>

                        <!-- Pie de la tarjeta: Precio y botón de acción -->
                        <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                            <div>
                                <small class="text-muted d-block" style="font-size: 0.7rem;">Precio</small>
                                <span class="fs-5 fw-bold text-dark">$@item.Precio.ToString("F2")</span>
                            </div>
                            <!-- Comprar descuenta una unidad del stock y se deshabilita si el producto está agotado -->
                            <form asp-action="Comprar" asp-route-id="@item.Id" method="post">
                                <button type="submit" class="btn text-white btn-sm rounded-pill px-3 fw-semibold" style="background-color: #1B4079;" disabled="@(item.Stock == 0)">
                                    <i class="bi bi-cart-plus me-1"></i> Comprar
                                </button>
                            </form>
                        </div>
                    </div>

                </div>
            </div>
        }
    }
</div>
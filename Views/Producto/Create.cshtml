@model TechStore.Models.Producto

@{
    ViewData["Title"] = "Agregar Producto";
}

<!-- ENCABEZADO DEL FORMULARIO -->
<div class="mb-4 pb-3 border-bottom mt-3">
    <h2 class="fw-bold text-dark mb-1">Agregar Producto</h2>
    <p class="text-muted small mb-0">Completa los datos para registrar un nuevo producto en la tienda.</p>
</div>

<!-- FORMULARIO DE REGISTRO -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <!-- Nombre -->
                <div class="col-md-6">
                    <label asp-for="Nombre" class="form-label fw-semibold"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>

                <!-- Categoría (lista desplegable cargada desde la base de datos) -->
                <div class="col-md-6">
                    <label asp-for="CategoriaId" class="form-label fw-semibold">Categoría</label>
                    <select asp-for="CategoriaId" asp-items="ViewBag.Categorias" class="form-select">
                        <option value="">Selecciona una categoría</option>
                    </select>
                    <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                </div>

                <!-- Descripción -->
                <div class="col-12">
                    <label asp-for="Descripcion" class="form-label fw-semibold">Descripción</label>
                    <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger small"></span>
                </div>

                <!-- Precio -->
                <div class="col-md-4">
                    <label asp-for="Precio" class="form-label fw-semibold"></label>
                    <input asp-for="Precio" class="form-control" />
                    <span asp-validation-for="Precio" class="text-danger small"></span>
                </div>

                <!-- Stock -->
                <div class="col-md-4">
                    <label asp-for="Stock" class="form-label fw-semibold"></label>
                    <input asp-for="Stock" class="form-control" />
                    <span asp-validation-for="Stock" class="text-danger small"></span>
                </div>

                <!-- Estado (Nuevo u Open Box) -->
                <div class="col-md-4">
                    <label asp-for="Estado" class="form-label fw-semibold"></label>
                    <select asp-for="Estado" asp-items="Html.GetEnumSelectList<TechStore.Models.Estado>()" class="form-select"></select>
                    <span asp-validation-for="Estado" class="text-danger small"></span>
                </div>

                <!-- Imagen -->
                <div class="col-12">
                    <label asp-for="Imagen" class="form-label fw-semibold">URL de la imagen</label>
                    <input asp-for="Imagen" class="form-control" />
                    <span asp-validation-for="Imagen" class="text-danger small"></span>
                </div>
            </div>

            <!-- Botones de acción -->
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-success rounded-pill px-4 fw-semibold">
                    <i class="bi bi-check-circle me-1"></i> Guardar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
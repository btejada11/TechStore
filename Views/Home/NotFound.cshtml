@{
    ViewData["Title"] = "Página No Encontrada";
}

<div class="container text-center py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card border-0 shadow-sm p-4 p-md-5 rounded-4 bg-white">
                <div class="mb-3" style="color: #1B4079;">
                    <i class="bi bi-search display-1"></i>
                </div>
                <h1 class="text-dark fw-bold mb-3" style="font-family: 'Orbitron', sans-serif;">
                    Página No <span style="color: #00d2ff;">Encontrada</span> (404)
                </h1>
                <p class="text-muted mb-4">
                    Lo sentimos, la página o recurso que buscas en TechStore no existe, fue eliminada o la URL es incorrecta.
                </p>

                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold shadow-sm" style="background-color: #1B4079; border: none;">
                        <i class="bi bi-house-door-fill me-1"></i> Volver al Inicio
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
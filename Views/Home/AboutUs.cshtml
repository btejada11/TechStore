@{
    ViewData["Title"] = "Acerca de Nosotros";
}

<div class="container-fluid px-0 mb-4">
    <!-- Banner Principal -->
    <header class="p-4 p-md-5 rounded-4 text-white shadow-sm mb-4" style="background: linear-gradient(135deg, #1B4079 0%, #122d56 100%);">
        <h1 class="display-5 fw-bold mb-2" style="font-family: 'Orbitron', sans-serif;">
            Acerca de <span style="color: #00d2ff;">Nosotros</span>
        </h1>
        <p class="lead text-white-50 mb-0" style="max-width: 700px;">
            Conoce la historia, los valores y el compromiso que impulsan cada una de nuestras soluciones tecnológicas.
        </p>
    </header>

    <!-- Sección ¿Quiénes somos? -->
    <section class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4 p-md-5">
            <div class="row align-items-center g-4">
                <div class="col-lg-9">
                    <span class="text-uppercase fw-bold small text-primary d-block mb-1" style="color: #1B4079 !important;">
                        Nuestra Empresa
                    </span>
                    <h2 class="fw-bold text-dark mb-3">¿Quiénes somos?</h2>
                    <p class="text-muted leading-relaxed mb-0 fs-6">
                        Somos una compañía tecnológica que pone la calidad, la innovación y el compromiso en el centro de cada solución que ofrecemos.
                        Desde nuestros inicios, nos hemos esforzado por brindar productos y servicios que no solo satisfacen las necesidades de nuestros clientes, sino que también superan sus expectativas.
                    </p>
                </div>
                <div class="col-lg-3 text-center d-none d-lg-block border-start">
                    <div class="p-3">
                        <i class="bi bi-laptop text-primary display-3" style="color: #1B4079 !important;"></i>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Misión, Visión y Valores -->
    <section class="row g-4">
        <!-- Nuestra Misión -->
        <div class="col-12 col-md-4">
            <article class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px; background-color: rgba(27, 64, 121, 0.1);">
                        <i class="bi bi-rocket-takeoff fs-4" style="color: #1B4079;"></i>
                    </div>
                    <h3 class="h5 fw-bold text-dark mb-2">Nuestra Misión</h3>
                    <p class="text-muted small mb-0 flex-grow-1">
                        Nuestro propósito es proporcionar productos y servicios innovadores que realmente transformen la vida de quienes confían en nosotros. Con un equipo competente y comprometido con la excelencia, buscamos constantemente nuevas formas de mejorar y evolucionar en un mundo tecnológico en constante cambio.
                    </p>
                </div>
            </article>
        </div>

        <!-- Nuestra Visión -->
        <div class="col-12 col-md-4">
            <article class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px; background-color: rgba(27, 64, 121, 0.1);">
                        <i class="bi bi-eye fs-4" style="color: #1B4079;"></i>
                    </div>
                    <h3 class="h5 fw-bold text-dark mb-2">Nuestra Visión</h3>
                    <p class="text-muted small mb-0 flex-grow-1">
                        Ser reconocidos como una compañía líder en soluciones tecnológicas, destacando por nuestra capacidad de innovación y la calidad de nuestros productos en cada mercado donde participamos.
                    </p>
                </div>
            </article>
        </div>

        <!-- Nuestros Valores -->
        <div class="col-12 col-md-4">
            <article class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px; background-color: rgba(27, 64, 121, 0.1);">
                        <i class="bi bi-shield-check fs-4" style="color: #1B4079;"></i>
                    </div>
                    <h3 class="h5 fw-bold text-dark mb-2">Nuestros Valores</h3>
                    <p class="text-muted small mb-0 flex-grow-1">
                        El compromiso, la honestidad, el trabajo en equipo y la innovación son los pilares que guían cada una de nuestras decisiones y acciones como compañía.
                    </p>
                </div>
            </article>
        </div>
    </section>
</div>
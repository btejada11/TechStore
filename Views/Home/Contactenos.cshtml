@{
    ViewData["Title"] = "Contáctenos";
}

<div class="container-fluid px-0 mb-5">

    <!-- 1. BANNER HERO PRINCIPAL -->
    <header class="p-4 p-md-5 rounded-4 text-white shadow-sm mb-4" style="background: linear-gradient(135deg, #1B4079 0%, #122d56 100%);">
        <h1 class="display-5 fw-bold mb-2" style="font-family: 'Orbitron', sans-serif;">
            Contáct<span style="color: #00d2ff;">enos</span>
        </h1>
        <p class="lead text-white-50 mb-0" style="max-width: 700px;">
            ¿Tienes alguna duda o inquietud? Estamos aquí para ayudarte. Ponte en contacto con nuestro equipo.
        </p>
    </header>

    <!-- 2. TARJETAS DE INFORMACIÓN DE CONTACTO -->
    <section class="row g-4 mb-4">
        <!-- Preguntas frecuentes / Atencion -->
        <div class="col-12 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-2">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 55px; height: 55px; background-color: rgba(27, 64, 121, 0.1);">
                        <i class="bi bi-telephone-fill fs-4" style="color: #1B4079;"></i>
                    </div>
                    <div>
                        <span class="text-uppercase text-muted fw-bold small">Llámanos</span>
                        <h5 class="fw-bold text-dark mb-0">Teléfono Directo</h5>
                        <a href="tel:+50312345678" class="text-decoration-none fw-semibold" style="color: #1B4079;">+503 1234-5678</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Correo Electronico -->
        <div class="col-12 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-2">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 55px; height: 55px; background-color: rgba(27, 64, 121, 0.1);">
                        <i class="bi bi-envelope-fill fs-4" style="color: #1B4079;"></i>
                    </div>
                    <div>
                        <span class="text-uppercase text-muted fw-bold small">Escríbenos</span>
                        <h5 class="fw-bold text-dark mb-0">Correo Electrónico</h5>
                        <a href="mailto:info@contactenos.com" class="text-decoration-none fw-semibold" style="color: #1B4079;">info@contactenos.com</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. SECCIÓN IMAGEN + FORMULARIO -->
    <section class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="row g-0">
            <!-- Imagen Lateral / Equipo -->
            <div class="col-12 col-lg-6 bg-light d-flex flex-column align-items-center justify-content-center p-4 border-end">
                <img src="~/Images/Contacto.jpg"
                     class="img-fluid rounded-3 shadow-sm mb-2"
                     alt="Equipo de atención al cliente"
                     style="max-height: 380px; width: 100%; object-fit: cover;"
                     onerror="this.onerror=null; this.src='https://picsum.photos/900/500';" />
                <span class="text-muted small fw-medium text-center">Atención al cliente personalizada</span>
            </div>

            <!-- Formulario de Mensaje -->
            <div class="col-12 col-lg-6 p-4 p-md-5">
                <h3 class="fw-bold text-dark mb-1">Envíanos un mensaje</h3>
                <p class="text-muted small mb-4">Completa el formulario y te responderemos a la brevedad.</p>

                <form class="contact-form">
                    <div class="mb-3">
                        <label for="nombre" class="form-label fw-bold text-muted small">Nombre completo</label>
                        <input type="text" class="form-control rounded-3" id="nombre" name="nombre" placeholder="Tu nombre" required />
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label fw-bold text-muted small">Correo electrónico</label>
                        <input type="email" class="form-control rounded-3" id="email" name="email" placeholder="tucorreo@ejemplo.com" required />
                    </div>

                    <div class="mb-4">
                        <label for="mensaje" class="form-label fw-bold text-muted small">Mensaje</label>
                        <textarea class="form-control rounded-3" id="mensaje" name="mensaje" rows="4" placeholder="Escribe tu mensaje aquí..." required></textarea>
                    </div>

                    <button type="submit" class="btn text-white rounded-pill px-4 py-2 fw-semibold shadow-sm w-100" style="background-color: #1B4079;">
                        <i class="bi bi-send-fill me-1"></i> Enviar mensaje
                    </button>
                </form>
            </div>
        </div>
    </section>

</div>
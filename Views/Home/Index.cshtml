@model TechStore.Models.HomeView

@{
    ViewData["Title"] = "Inicio";
}

<!-- Contenedor principal -->
<div class="w-100 px-3 px-md-4">

    <!-- 1. BANNER DE BIENVENIDA (HERO) -->
    <header class="card border-0 shadow-sm mb-4 text-white" style="background: linear-gradient(135deg, #1B4079 0%, #122d56 100%); border-radius: 12px;">
        <div class="card-body p-3 p-md-4 p-lg-5 d-flex flex-column flex-xl-row align-items-center justify-content-between gap-4">

            <!-- Columna izquierda: Titulo y descripcion -->
            <div class="text-center text-xl-start">
                <span class="badge bg-info text-dark fw-bold mb-2 px-3 py-2 text-uppercase">
                    <i class="bi bi-bag-check-fill me-1"></i> Tienda Oficial TechStore
                </span>
                <h1 class="fw-bold mb-2 display-6" style="font-family: 'Orbitron', sans-serif;">
                    Lo mejor en <span style="color: #00d2ff;">Tecnología</span> a tu alcance
                </h1>
                <p class="mb-0 text-white-50 fs-6" style="max-width: 600px;">
                    Descubre los mejores equipos, laptops, periféricos y accesorios de última generación con envíos garantizados y la mejor calidad.
                </p>
            </div>

            <!-- Columna derecha: Tarjeta semi-transparente con los integrantes del proyecto -->
            <div class="bg-white bg-opacity-10 p-3 p-md-4 rounded-3 border border-white border-opacity-10 w-100 min-w-sm" style="max-width: 420px;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h6 class="text-uppercase fw-bold text-info mb-0 fs-7" style="letter-spacing: 1px;">
                        <i class="bi bi-people-fill me-2"></i>Equipo Desarrollo
                    </h6>
                    <span class="badge bg-secondary bg-opacity-50 text-white-50 fs-8">Proyecto FrontEnd</span>
                </div>
                <hr class="border-white opacity-25 my-2">
                <ul class="list-unstyled mb-0 small text-start">
                    <li class="py-1"><i class="bi bi-person-badge me-2 text-info"></i>Bryan Leonel Tejada Durán &mdash; <span class="fw-semibold text-white-50">2025010751</span></li>
                    <li class="py-1"><i class="bi bi-person-badge me-2 text-info"></i>Andrés Elías Martínez Rivera &mdash; <span class="fw-semibold text-white-50">2025011308</span></li>
                    <li class="py-1"><i class="bi bi-person-badge me-2 text-info"></i>Herberth Efrén Rivas Granado &mdash; <span class="fw-semibold text-white-50">2025010500</span></li>
                    <li class="py-1"><i class="bi bi-person-badge me-2 text-info"></i>Bairon Ezequiel Reyes Ramírez &mdash; <span class="fw-semibold text-white-50">Pendiente</span></li>
                </ul>
            </div>

        </div>
    </header>

    <!-- 2. SECCIÓN SOBRE NUESTRO SERVICIO -->
    <div class="card shadow-sm border-0 mb-4 rounded-3 overflow-hidden">
        <div class="row g-0 align-items-center">
            <!-- Columna de la imagen descriptiva -->
            <div class="col-lg-5 col-md-12">
                <img src="~/Images/AI.jpg" class="img-fluid h-100 w-100" style="object-fit: cover; min-height: 240px; max-height: 350px;" alt="Servicio TechStore">
            </div>
            <!-- Columna de texto sobre nosotros -->
            <div class="col-lg-7 col-md-12">
                <div class="card-body p-4 p-md-5">
                    <span class="text-primary fw-bold text-uppercase fs-7">Sobre nosotros</span>
                    <h3 class="card-title fw-bold text-dark mb-3">Nuestro Servicio</h3>
                    <p class="card-text text-muted fs-6 leading-relaxed mb-0">
                        TechStore se enfoca en ofrecer una amplia variedad de categorías de productos tecnológicos, incluyendo computadoras, teléfonos inteligentes, accesorios y más. Nuestro objetivo es proporcionar a nuestros clientes la mejor experiencia de compra en línea, con productos de alta calidad y un servicio al cliente excepcional.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. TARJETAS DE BENEFICIOS Y GARANTÍAS -->
    <section class="mb-4">
        <div class="row g-3">
            <!-- Beneficio 1: Envios -->
            <div class="col-lg-4 col-sm-6 col-12">
                <div class="card border-0 shadow-sm h-100 p-3" style="border-radius: 10px;">
                    <div class="card-body d-flex align-items-center gap-3 p-1">
                        <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; flex-shrink: 0;">
                            <i class="bi bi-truck fs-4" style="color: #1B4079;"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1 text-dark">Envíos Garantizados</h6>
                            <p class="text-muted small mb-0">Entrega rápida y segura de tus dispositivos.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Beneficio 2: Garantia -->
            <div class="col-lg-4 col-sm-6 col-12">
                <div class="card border-0 shadow-sm h-100 p-3" style="border-radius: 10px;">
                    <div class="card-body d-flex align-items-center gap-3 p-1">
                        <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; flex-shrink: 0;">
                            <i class="bi bi-shield-check fs-4" style="color: #1B4079;"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1 text-dark">Garantía Oficial</h6>
                            <p class="text-muted small mb-0">Respaldo y soporte técnico autorizado.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Beneficio 3: Soporte -->
            <div class="col-lg-4 col-sm-12 col-12">
                <div class="card border-0 shadow-sm h-100 p-3" style="border-radius: 10px;">
                    <div class="card-body d-flex align-items-center gap-3 p-1">
                        <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; flex-shrink: 0;">
                            <i class="bi bi-headset fs-4" style="color: #1B4079;"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1 text-dark">Atención Especializada</h6>
                            <p class="text-muted small mb-0">Asesoría para elegir el mejor equipo.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. ENLACES DIRECTOS (ACCESOS RÁPIDOS UNIFICADOS) -->
    <section class="mb-3">
        <div class="row g-3">
            <!-- Acceso a Productos -->
            <div class="col-md-6 col-12">
                <div class="p-4 rounded-3 text-white d-flex flex-wrap align-items-center justify-content-between gap-2 shadow-sm" style="background: linear-gradient(135deg, #122d56 0%, #1B4079 100%); border-radius: 10px;">
                    <div>
                        <h5 class="fw-bold mb-1">Catálogo Tecnológico</h5>
                        <p class="text-white-50 small mb-0">Explora la lista completa de productos.</p>
                    </div>
                    <a asp-controller="Producto" asp-action="Index" class="btn btn-light fw-bold text-dark px-3 py-2">
                        Ver Productos <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>

            <!-- Acceso a Categorias -->
            <div class="col-md-6 col-12">
                <div class="p-4 rounded-3 text-white d-flex flex-wrap align-items-center justify-content-between gap-2 shadow-sm" style="background: linear-gradient(135deg, #0d2347 0%, #173763 100%); border-radius: 10px;">
                    <div>
                        <h5 class="fw-bold mb-1">Nuestras Categorías</h5>
                        <p class="text-white-50 small mb-0">Filtra tus búsquedas por categorías.</p>
                    </div>
                    <a asp-controller="Categoria" asp-action="Index" class="btn btn-outline-light fw-bold px-3 py-2">
                        Ver Categorías <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </section>

</div>

<!-- CSS local -->
<style>
    .w-100 {
        width: 100% !important;
    }

    .row {
        margin-right: 0 !important;
        margin-left: 0 !important;
    }

    .fs-7 {
        font-size: 0.8rem;
    }

    .fs-8 {
        font-size: 0.72rem;
    }
</style>
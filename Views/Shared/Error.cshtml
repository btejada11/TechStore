@model ErrorViewModel
@{
    ViewData["Title"] = "Error del Sistema";
}

<div class="container text-center py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card border-0 shadow-sm p-4 p-md-5 rounded-4 bg-white">
                <div class="text-danger mb-3">
                    <i class="bi bi-exclamation-octagon-fill display-1"></i>
                </div>
                <h1 class="text-dark fw-bold mb-3" style="font-family: 'Orbitron', sans-serif;">
                    ¡Ocurrió un <span class="text-danger">Error!</span>
                </h1>
                <p class="text-muted mb-4">
                    Lo sentimos, ha ocurrido un error inesperado al procesar tu solicitud en TechStore. Nuestro equipo técnico ha sido notificado.
                </p>

                @if (Model.ShowRequestId)
                {
                    <div class="alert alert-light border small text-secondary py-2 rounded-3 mb-4">
                        <strong>Request ID:</strong> <code>@Model.RequestId</code>
                    </div>
                }

                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold shadow-sm" style="background-color: #1B4079; border: none;">
                        <i class="bi bi-house-door-fill me-1"></i> Volver al Inicio
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
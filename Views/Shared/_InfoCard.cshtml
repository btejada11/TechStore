@model TechStore.Models.InfoCardViewModel

<div class="col-12 col-md-4">
    <article class="card border-0 shadow-sm rounded-4 h-100">
        <div class="card-body p-4 d-flex flex-column">

            <div class="rounded-circle d-flex align-items-center
                        justify-content-center mb-3"
                 style="width: 50px; height: 50px;
                        background-color: rgba(27, 64, 121, 0.1);">

                <i class="bi @Model.Icono fs-4"
                   style="color: #1B4079;"></i>
            </div>

            <h3 class="h5 fw-bold text-dark mb-2">
                @Model.Titulo

            </h3>

            <p class="text-muted small mb-0 flex-grow-1">
                @Model.Descripcion

            </p>

        </div>
    </article>
</div>

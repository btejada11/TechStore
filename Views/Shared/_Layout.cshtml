<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechStore</title>

    <!-- Librerías externas -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Orbitron:wght@700;900&display=swap" rel="stylesheet">

    <!-- CSS del proyecto con control de versión para evitar problemas de caché -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        /* Tipografia general y fondo para el cuerpo de la pagina */
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f4f6f9;
        }

        /* Estilo para el nombre TechStore usando la fuente Orbitron */
        .brand-title {
            font-family: 'Orbitron', sans-serif;
            letter-spacing: 1.5px;
            font-size: 1.6rem;
            color: #ffffff;
            text-transform: uppercase;
        }

        /* Sidebar con el color azul marino (#1B4079) */
        .sidebar-custom {
            background: #1B4079;
            box-shadow: 4px 0 15px rgba(0,0,0,0.1);
        }

        /* Diseño base para las opciones del menu lateral */
        .nav-link-custom {
            color: #dbeaff;
            border-radius: 10px;
            padding: 12px 16px;
            font-weight: 500;
            transition: all 0.25s ease;
        }

        /* Efecto al pasar el mouse */
        .nav-link-custom:hover, .nav-link-custom.active {
            background: rgba(255, 255, 255, 0.15);
            color: #ffffff !important;
            transform: translateX(4px);
        }

        /* Iconos en color blanco */
        .nav-link-custom i {
            color: #ffffff;
        }
    </style>
</head>
<body>
    <div class="container-fluid p-0">
        <div class="row g-0 flex-nowrap">

            <!-- El panel lateral de navegación -->
            <aside class="col-auto col-md-3 col-xl-2 min-vh-100 sidebar-custom d-flex flex-column justify-content-between p-3 position-sticky top-0" style="z-index: 1000;">
                <div>
                    <!-- Encabezado -->
                    <a asp-controller="Home" asp-action="Index" class="d-flex align-items-center justify-content-center text-decoration-none pb-4 pt-3 mb-3 border-bottom border-white border-opacity-25">
                        <span class="brand-title fw-black">Tech<span class="text-info">Store</span></span>
                    </a>

                    <!-- Enlaces principales del sitio -->
                    <nav class="nav nav-pills flex-column gap-2" id="menu">
                        <a asp-controller="Home" asp-action="Index" class="nav-link nav-link-custom d-flex align-items-center gap-3">
                            <i class="bi bi-house-door-fill fs-5"></i>
                            <span class="d-none d-sm-inline">Inicio</span>
                        </a>
                        <a asp-controller="Producto" asp-action="Index" class="nav-link nav-link-custom d-flex align-items-center gap-3">
                            <i class="bi bi-grid-fill fs-5"></i>
                            <span class="d-none d-sm-inline">Productos</span>
                        </a>
                        <a asp-controller="Categoria" asp-action="Index" class="nav-link nav-link-custom d-flex align-items-center gap-3">
                            <i class="bi bi-tags-fill fs-5"></i>
                            <span class="d-none d-sm-inline">Categorías</span>
                        </a>
                        <a asp-controller="Home" asp-action="AcercaDe" class="nav-link nav-link-custom d-flex align-items-center gap-3">
                            <i class="bi bi-info-circle-fill fs-5"></i>
                            <span class="d-none d-sm-inline">Acerca de</span>
                        </a>
                        <a asp-controller="Home" asp-action="Contactenos" class="nav-link nav-link-custom d-flex align-items-center gap-3">
                            <i class="bi bi-envelope-fill fs-5"></i>
                            <span class="d-none d-sm-inline">Contáctenos</span>
                        </a>
                    </nav>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">TechStore</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Contactenos">Contactenos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="AboutUs">Acerca de Nosotros</a>
                        </li>
                    </ul>
                </div>

                <!-- derechos de autor o simplemente el pie de pagina -->
                <div class="pt-3 border-top border-white border-opacity-25 text-white-50 small d-none d-sm-block text-center">
                    <small class="d-block text-white-50">TechStore &copy; 2026</small>
                </div>
            </aside>

            <!-- Area de contenido principal, Ocupa el espacio derecho y empuja el footer al fondo -->
            <div class="col min-vh-100 d-flex flex-column justify-content-between">

                <!-- Aquí se renderizan las vistas secundarias (Index, Productos, etc.) -->
                <main role="main" class="p-4 flex-grow-1">
                    @RenderBody()
                </main>

                <!-- Pie de página global -->
                <footer class="bg-white border-top py-3 px-4 text-center text-muted small">
                    Proyecto FrontEnd - ASP.NET Core MVC | TechStore 2026
                </footer>
            </div>

        </div>
    </div>

    <!-- Scripts requeridos al final del archivo para acelerar la carga visual -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>